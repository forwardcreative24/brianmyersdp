# Pages are never cached, so a new deploy shows up right away.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Built files have a fingerprint in the name, so they can be kept for good.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Photos and video can be cached for a day. The ! line drops the page rule above
# first, otherwise Cloudflare joins the two Cache-Control values together.
/images/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/video/*
  ! Cache-Control
  Cache-Control: public, max-age=86400
