---
import '../styles/global.css';
import { site, nav } from '../site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.description, image } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}, ${site.title}` : `${site.name} | ${site.title} in ${site.location}`;
const path = Astro.url.pathname;
// Link previews need an absolute URL; pages without a still share the default card.
const shareImage = new URL(image ?? '/images/share.jpg', Astro.site).href;
const canonical = new URL(path, Astro.site).href;
const tel = site.phone.replace(/\D/g, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#141517" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${site.name}, ${site.title}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="masthead wrap">
      <a class:list={['wordmark', `wordmark--${site.wordmark}`]} href="/">
        <span class="wm-name">{site.name}</span>
        {site.wordmark !== 'name' && <span class="wm-title">{site.title}</span>}
      </a>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <button class="menu-btn" type="button" aria-label="Menu" aria-haspopup="dialog"><span></span><span></span></button>
      <dialog class="phone-menu" aria-label="Menu" tabindex="-1">
        <div class="phone-menu-top wrap">
          <a class:list={['wordmark', `wordmark--${site.wordmark}`]} href="/">
            <span class="wm-name">{site.name}</span>
            {site.wordmark !== 'name' && <span class="wm-title">{site.title}</span>}
          </a>
          <button class="phone-menu-close" type="button" aria-label="Close menu">&times;</button>
        </div>
        <nav class="wrap" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <p class="phone-menu-foot wrap mono"><a href={`mailto:${site.email}`}>{site.email}</a><a href={`tel:${tel}`}>{site.phone}</a></p>
      </dialog>
    </header>
    <script is:inline>
      // Hairline under the header once you've scrolled; phone menu opens full screen.
      (() => {
        const head = document.querySelector('.masthead');
        const update = () => head.classList.toggle('is-pinned', scrollY > 8);
        addEventListener('scroll', update, { passive: true });
        update();
        const menu = document.querySelector('.phone-menu');
        document.querySelector('.menu-btn').addEventListener('click', () => { menu.showModal(); menu.focus(); });
        menu.querySelector('.phone-menu-close').addEventListener('click', () => menu.close());
        menu.addEventListener('click', (e) => { if (e.target.closest('a')) menu.close(); });
        matchMedia('(max-width: 760px)').addEventListener('change', (e) => { if (!e.matches) menu.close(); });
      })();
    </script>
    <main>
      <slot />
    </main>
    <footer class="footer wrap">
      <a class="big-link" href="/contact/">Let's make something</a>
      <dl class="footer-meta">
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Call / text</dt><dd><a href={`tel:${tel}`}>{site.phone}</a></dd></div>
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
        <div><dt>Social</dt><dd><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></dd></div>
      </dl>
      <p class="fine mono">© {new Date().getFullYear()} {site.name}</p>
    </footer>
    <script is:inline>
      // Card loops: on a computer they play while the mouse is over the card; on phones, whichever card is on screen plays.
      (() => {
        const vids = [...document.querySelectorAll('.card video')];
        if (!vids.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const play = (v) => v.play().then(() => v.classList.add('is-playing')).catch(() => {});
        const stop = (v) => { v.classList.remove('is-playing'); v.pause(); };
        if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
          for (const v of vids) {
            const card = v.closest('.card');
            card.addEventListener('mouseenter', () => play(v));
            card.addEventListener('mouseleave', () => { stop(v); v.currentTime = 0; });
          }
        } else {
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) e.isIntersecting ? play(e.target) : stop(e.target);
          }, { threshold: 0.6 });
          vids.forEach((v) => io.observe(v));
        }
      })();
    </script>
  </body>
</html>
