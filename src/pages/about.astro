---
import Base from '../layouts/Base.astro';
import { site } from '../site';
// Behind-the-scenes photos for the grid under the text, in order.
const photos = Array.from({ length: 17 }, (_, i) => `/images/about/${String(i + 1).padStart(2, '0')}.jpg`);
---
<Base title="About">
  <section class="wrap page about">
    <h1>About</h1>
    <div class="about-grid">
      <img class="portrait" src="/images/portrait.jpg" alt={`${site.name} on set`} />
      <div class="prose lede">
        <p>I'm Brian, a DP and director based in Indiana. I love working with a team to craft tasteful imagery for commercial, cine-doc, and high-end corporate projects. I shoot for directors and agencies, and direct when a project calls for it.</p>
        <p>My goal is to bring a positive attitude, clear vision, and professional excellence to every job. I've worked with big brands you've heard of ({site.clients.join(', ')}) and a bunch of smaller businesses and organizations you probably haven't.</p>
        <p>I'm pretty familiar with tight schedules, day-of changes, big crews, small crews, no crew, late nights, early mornings, and finally, taking a breath at the wrap party.</p>
        <p>I have three kids, a lot of cameras, and a soft spot for sci-fi.</p>
      </div>
    </div>
    <div class="stills bts">
      {photos.map((src) => <img src={src} alt="Behind the scenes" loading="lazy" />)}
    </div>
  </section>
</Base>
