---
import Base from '../layouts/Base.astro';
import { site } from '../site';
const tel = site.phone.replace(/\D/g, '');
---
<Base title="Contact">
  <section class="wrap page contact">
    <h1>Let's chat</h1>
    <div class="contact-grid">
      <dl class="credits">
        <div><dt>Call / text</dt><dd><a href={`tel:${tel}`}>{site.phone}</a></dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${site.email}?subject=DP%20Inquiry`}>{site.email}</a></dd></div>
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
      </dl>
      <form class="form" action="https://api.web3forms.com/submit" method="POST" data-key={site.formKey} data-email={site.email}>
        <p class="lede">Or shoot over some details. I look forward to learning about your project.</p>
        <input type="hidden" name="access_key" value={site.formKey} />
        <input type="hidden" name="subject" value="DP inquiry from brianmyersdp.com" />
        <label>Name<input name="name" required autocomplete="name" /></label>
        <label>Email<input name="email" type="email" required autocomplete="email" /></label>
        <label>Company or production<input name="company" /></label>
        <label>Shoot dates<input name="dates" /></label>
        <label>Tell me about the project<textarea name="message" rows="5" required></textarea></label>
        <button class="button" type="submit">Send</button>
        <p class="form-done lede" hidden>Thanks, got it. I'll get back to you soon.</p>
      </form>
    </div>
  </section>
  <script is:inline>
    // Sends through Web3Forms when a key is set; otherwise opens an email with the details filled in.
    document.querySelectorAll('.form').forEach((form) => form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (!form.dataset.key) {
        const body = ['name', 'email', 'company', 'dates', 'message'].map((k) => `${k}: ${data.get(k) || ''}`).join('\n');
        location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('DP Inquiry')}&body=${encodeURIComponent(body)}`;
        return;
      }
      const res = await fetch(form.action, { method: 'POST', body: data, headers: { Accept: 'application/json' } }).catch(() => null);
      if (res && res.ok) {
        [...form.children].forEach((c) => { c.hidden = !c.classList.contains('form-done'); });
      } else {
        alert(`That didn't send. Please email ${form.dataset.email}.`);
      }
    }));
  </script>
</Base>
