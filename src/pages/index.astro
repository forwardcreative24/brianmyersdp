---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { site } from '../site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
---
<Base>
  <section class="wrap section section--first">
    <div class="section-head">
      <h2>Selected work</h2>
    </div>
    <WorkGrid projects={featured} filters={[]} />
    <a class="all-work" href="/work/"><span>See all work</span><span aria-hidden="true">→</span></a>
  </section>

  <section class="wrap section clients">
    <p class="kicker">Worked with</p>
    <p class="client-list">{site.clients.join(' · ')}</p>
  </section>

</Base>
